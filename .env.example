# Stripe TEST keys from https://dashboard.stripe.com/test/apikeys
# Leave unset to run in demo mode (a local, clearly-labelled simulation
# of the Stripe Checkout page — no network calls to Stripe).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Public URL used for success/cancel redirects (defaults to http://localhost:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
